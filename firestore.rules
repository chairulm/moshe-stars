rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function hasRoles() { return exists(/databases/$(database)/documents/meta/roles); }
    function roles() { return get(/databases/$(database)/documents/meta/roles).data; }
    function signedIn() { return request.auth != null; }
    function isDad() { return signedIn() && hasRoles() && request.auth.uid == roles().dad; }
    function isMoshe() { return signedIn() && hasRoles() && request.auth.uid == roles().moshe; }
    function member() { return isDad() || isMoshe(); }

    // Login names → internal emails. Readable before login so the login screen works.
    match /meta/login {
      allow read: if true;
      allow write: if isDad();
    }

    // Who is Dad and who is Moshe. Created once at first-time setup by Dad.
    match /meta/roles {
      allow read: if member();
      allow create: if signedIn() && !hasRoles()
                    && request.resource.data.dad == request.auth.uid
                    && request.resource.data.keys().hasOnly(['dad', 'moshe']);
      allow update: if isDad()
                    && request.resource.data.dad == resource.data.dad
                    && request.resource.data.keys().hasOnly(['dad', 'moshe']);
      allow delete: if false;
    }

    // Moshe's own ticks — only Moshe writes them.
    match /self/{week} {
      allow read: if member();
      allow write: if isMoshe() && week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Photo evidence (compressed JPEG data URL) — only Moshe writes.
    match /photos/{id} {
      allow read: if member();
      allow create, update: if isMoshe()
                            && request.resource.data.img is string
                            && request.resource.data.img.size() < 400000;
      allow delete: if isMoshe();
    }

    // Dad's scores and reasons — only Dad writes.
    match /review/{week} {
      allow read: if member();
      allow write: if isDad() && week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /{document=**} { allow read, write: if false; }
  }
}
